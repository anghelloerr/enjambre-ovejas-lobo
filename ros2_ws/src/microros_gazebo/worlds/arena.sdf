<?xml version="1.0"?>
<!-- Arena cuadrada de 4 m x 4 m con corral (zona verde) para el enjambre ovejas-lobo -->
<sdf version="1.8">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corral">
      <static>true</static>
      <pose>1.2 1.2 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.6</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></collision>
        <visual name="vn"><pose>0 2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></visual>
        <collision name="s"><pose>0 -2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></collision>
        <visual name="vs"><pose>0 -2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></visual>
        <collision name="e"><pose>2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.2 0.2</size></box></geometry></collision>
        <visual name="ve"><pose>2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.2 0.2</size></box></geometry></visual>
        <collision name="w"><pose>-2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.2 0.2</size></box></geometry></collision>
        <visual name="vw"><pose>-2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.2 0.2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
