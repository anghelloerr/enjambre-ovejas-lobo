<?xml version="1.0"?>
<package format="3">
  <name>swarm_sheep_wolf</name>
  <version>0.1.0</version>
  <description>Algoritmo bioinspirado ovejas-lobo (Reynolds + pastoreo de Strömbom) para enjambres MicroROS-Pi5.</description>
  <maintainer email="anghello.rodriguez@ieee.org">anghelloerr</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>microros_gazebo</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
